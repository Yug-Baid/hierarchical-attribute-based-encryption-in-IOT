# Copy this to .env and fill in your values
# cp .env.example .env

PORT=3000

# Set to true to use real Hyperledger Besu, false for in-memory stub
BESU_ENABLED=true

# Besu JSON-RPC endpoint
RPC_URL=http://localhost:8545

# Deployed HABERegistry contract address (from blockchain/config/deployment.json)
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Besu node private key (from blockchain/config/node_key)
OPERATOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ML eligibility service (default: http://127.0.0.1:5001)
ELIGIBILITY_URL=http://127.0.0.1:5001
